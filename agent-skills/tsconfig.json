{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "plugins/algoria/lib/**/*.mjs",
    "plugins/algoria/skills/**/*.mjs",
    "tests/**/*.mjs",
    "build/**/*.mjs"
  ],
  "exclude": [
    "plugins/algoria/lib/vendor/**"
  ]
}
